<!-- Dùng để chạy offline SLAM từ rosbag, tạo map -->

<launch>
  <param name="/use_sim_time" value="true" />
  <arg name="skip_seconds" default="0" />
  <arg name="bag_filenames" default="/home/linhbn/Tendo_1F.bag" />
  <arg name="no_rviz" default="false" />

  <node name="cartographer_offline_node" pkg="cartographer_ros"
      required="$(arg no_rviz)"
      type="cartographer_offline_node" args="
          -configuration_directory $(find cartographer_run)/configuration_files
          -configuration_basenames slam_config.lua
          -bag_filenames $(arg bag_filenames)
          -skip_seconds $(arg skip_seconds)
          -collect_metrics"
      output="screen">
      <remap from="scan" to="scan_1_filter" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution 0.05" output="screen">
    <param name="publish_period_sec" value="1.0"/>
  </node>
</launch>
