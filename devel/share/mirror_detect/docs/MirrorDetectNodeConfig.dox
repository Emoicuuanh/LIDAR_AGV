\subsubsection parameters ROS parameters

Reads and maintains the following parameters on the ROS server

- \b "~intensity_range" : \b [str] Filepath of intensity range min: , default: , max: 
- \b "~dock_filepath" : \b [str] Filepath of dock target pointcloud min: , default: , max: 
- \b "~world_frame" : \b [str] Name of world frame min: , default: world, max: 
- \b "~robot_frame" : \b [str] Name of robot frame min: , default: base_link, max: 
- \b "~cloud_frame" : \b [str] Name of cloud frame min: , default: cloud, max: 
- \b "~cloud_topic" : \b [str] Name of cloud frame min: , default: cloud, max: 
- \b "~scan_mirror_topic_" : \b [str] Name of scan_mirror frame min: , default: scan_mirror, max: 
- \b "~laser_frame" : \b [str] Name of laser frame min: , default: base_laser_link, max: 
- \b "~laser_topic" : \b [str] Name of laser topic min: , default: scan, max: 
- \b "~RS_max_iter" : \b [int] Số vòng lặp tính toán min: 0, default: 250, max: 10000
- \b "~RS_min_inliers" : \b [int] Số điểm tối thiểu để coi là 1 đoạn thẳng min: 0, default: 3, max: 50
- \b "~RS_dist_thresh" : \b [double] Khoảng cách giữa các điểm theo chiều vuông góc với đoạn thẳng nhỏ hơn param này thì coi là đoạn thẳng (noise) min: 0.0, default: 0.02, max: 1.0
- \b "~RANSAC_on_clusters" : \b [bool] Perform RANSAC after Clustering Points min: False, default: True, max: True
- \b "~publish_scan" : \b [bool] publish scan yes or no min: False, default: True, max: True
- \b "~use_laser" : \b [bool] use laser or cloud min: False, default: True, max: True
- \b "~use_diff_laser" : \b [bool] use 2 laser intensity min: False, default: True, max: True
- \b "~Voxel_leaf_size" : \b [double] Leaf Size for Voxel Grid min: 0.0, default: 0.0001, max: 1.0
- \b "~mirror_point_publish" : \b [int] Số point publish ra min: 0, default: 250, max: 10000
- \b "~EC_cluster_tolerance" : \b [double] Khoảng cách tối đa giữa các điểm có thể coi là 1 cụm (m) min: 0.0, default: 0.08, max: 0.5
- \b "~EC_min_size" : \b [int] Số lượng điểm tối thiểu trong 1 cụm min: 0, default: 10, max: 20
- \b "~EC_max_size" : \b [int] Số lượng điểm tối đa trong 1 cụm min: 0, default: 250, max: 1000
- \b "~detect_type" : \b [int] Detect marker type min: 0, default: 0, max: 4
- \b "~radius_detect" : \b [double] Detect radius type min: 0.0, default: 0.001, max: 0.8
- \b "~intensity_times" : \b [double] intensity_times when discard min: 0.0, default: 0.001, max: 2.45
- \b "~length_mirror" : \b [double] length of line mirror min: 0.0, default: 0.01, max: 2.0
- \b "~radius_tolerance" : \b [double] Detect radius error min: 0.0, default: 0.0001, max: 0.8
- \b "~max_cluster_size" : \b [double] max_cluster_size_discard min: 0.0, default: 0.0, max: 4.0
- \b "~max_intensity_time" : \b [double] max intensity approx min: 0.0, default: 0.01, max: 5.0
- \b "~laser_resolution" : \b [double] laser_resolution_config min: 0.0, default: 0.01, max: 1.0
- \b "~point_discard" : \b [int] discard_too_less_point min: 0, default: 0, max: 30
- \b "~line_discard" : \b [int] discard line below min: 0, default: 0, max: 4
- \b "~mirror_type" : \b [int] mirror detect min: 0, default: 0, max: 4
- \b "~icp_type" : \b [int] icp_type min: 0, default: 0, max: 4
- \b "~ICP_min_score" : \b [double] ICP Fitness Score Threshold min: 0.0, default: 0.001, max: 0.2
- \b "~length_tolerance" : \b [double] length_mirror tolerance min: 0.0, default: 0.001, max: 0.2
- \b "~ICP_max_corres_dist" : \b [double] The maximum distance threshold between two correspondent points min: 0.001, default: 0.1, max: 1.0
- \b "~ICP_max_iter" : \b [int] Max iterations min: 1, default: 100, max: 1000
- \b "~ICP_max_transl_eps" : \b [double] Max transformation translation epsilon (diff) btwn previous & current estimated  min: 1e-09, default: 1e-09, max: 0.001
- \b "~ICP_max_rot_eps" : \b [double] Max transformation rotation epsilon (diff) btwn previous & current estimated  min: 1e-09, default: 1e-09, max: 0.001
- \b "~ICP_max_eucl_fit_eps" : \b [double] Max Euclidean squared errors min: 0.0, default: 1.0, max: 2.0
- \b "~BAR_length" : \b [double] Bar marker length (m) min: 0.0, default: 0.2, max: 10.0
- \b "~BAR_length_tolerance" : \b [double] Bar marker length tolerance (m) min: 0.0, default: 0.2, max: 1.0
- \b "~BAR_distance" : \b [double] Bar marker distance (m) min: 0.0, default: 0.2, max: 10.0
- \b "~BAR_distance_tolerance" : \b [double] Bar marker distance tolerance (m) min: 0.0, default: 0.2, max: 1.0
- \b "~Leg_length" : \b [double] Leg marker length (m) min: 0.0, default: 0.68, max: 10.0
- \b "~Leg_distance" : \b [double] Leg marker distance (m) min: 0.0, default: 0.85, max: 10.0
- \b "~Leg_offset" : \b [double] Leg marker offset (m) min: 0.0, default: 0.18, max: 10.0
- \b "~Leg_tolerance" : \b [double] Leg marker accuracy tolerance (m) min: 0.0, default: 0.1, max: 1.0

